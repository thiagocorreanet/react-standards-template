{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!**/dist",
      "!**/node_modules",
      "!**/playwright-report",
      "!**/test-results",
      "!**/pnpm-lock.yaml",
      "!**/.claude/settings.local.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 80 },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "message": "Import features through their public index.ts."
              },
              {
                "group": ["@/mocks/**"],
                "message": "Mocks belong to development and tests only."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/components/ui/**"],
      "linter": { "enabled": false }
    }
  ]
}
